{
  "name": "post-bird",
  "version": "1.0.0",
  "description": "To test Api",
  "homepage": "https://github.com/punitha-avrl/post-bird#readme",
  "bugs": {
    "url": "https://github.com/punitha-avrl/post-bird/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/punitha-avrl/post-bird.git"
  },
  "license": "ISC",
  "author": "Punitha Shunmnugam",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "app:dir": "electron-builder --dir",
    "app:dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "axios": "^1.21.0"
  },
  "build": {
    "appId": "post-bird",
    "productName": "Post Bird",
    "icon": "assets/icon.ico",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true
    }
  }
}
