{
  "name": "post-bird",
  "version": "1.0.0",
  "description": "To test Api",
  "homepage": "https://github.com/punitha-avrl/post-bird#readme",
  "bugs": {
    "url": "https://github.com/punitha-avrl/post-bird/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/punitha-avrl/post-bird.git"
  },
  "license": "ISC",
  "author": "Punitha Shunmnugam",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "app:dir": "electron-builder --dir",
    "app:dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "clear-module": "^4.1.2",
    "clone-response": "^1.0.3",
    "dialog": "^0.3.1",
    "electron-context-menu": "^3.1.2",
    "electron-log": "^4.4.6",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-store": "^8.0.1",
    "find-remove": "^4.0.4",
    "http": "^0.0.1-security",
    "https-proxy-agent": "^5.0.1",
    "json5": "^2.2.1",
    "node-fetch": "^2.6.7",
    "node-schedule": "^2.1.0",
    "request": "^2.88.2",
    "require-from-url": "^3.1.3",
    "xhr2": "^0.2.1"
  },
  "build": {
    "appId": "post-bird",
    "productName": "Post Bird",
    "icon": "assets/icon.ico",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true
    }
  }
}
